# Copy this file to .env and fill it in. See the README's "Setup" section.

# --- Rail Data Marketplace Kafka feeds (from each product's Pub/Sub tab) --------------------
KAFKA_BOOTSTRAP_SERVERS=

# Darwin Push Port
DARWIN_CONSUMER_GROUP_ID=
DARWIN_CONSUMER_USERNAME=
DARWIN_CONSUMER_PASSWORD=

# LINX Passenger Train Allocation and Consist
NWR_CONSUMER_GROUP_ID=
NWR_CONSUMER_USERNAME=
NWR_CONSUMER_PASSWORD=

# NWR Train Describer (TD) - optional; leave blank to skip
NWR_TD_TOPIC=TD_ALL_SIG_AREA
NWR_TD_CONSUMER_GROUP_ID=
NWR_TD_CONSUMER_USERNAME=
NWR_TD_CONSUMER_PASSWORD=
# NWR_TD_BOOTSTRAP_SERVERS=   (only if different from KAFKA_BOOTSTRAP_SERVERS)

# --- Downloaded Network Rail files (relative to backend/; .json or .json.gz both work) -------
NWR_SCHEDULE_FILE=data/CIF_ALL_FULL_DAILY_toc-full.json
NWR_CORPUS_FILE=data/CORPUSExtract.json
NWR_SMART_FILE=data/SMARTExtract.json

# --- Your window ------------------------------------------------------------------------------
# The station it overlooks: a CRS code (e.g. WNT, SUR) or a TIPLOC
WINDOW_STATION=WNT
# Optional per-station overrides of anything derived, as JSON keyed by station code
WINDOW_OVERRIDES={"WNT": {"approach_points": [{"tiploc": "PUTNEY", "event": "B"}]}}

# --- Photos and descriptions ------------------------------------------------------------------
# Wikimedia asks API clients to identify themselves; include a way to contact you
ROLLING_STOCK_USER_AGENT=WhatTrainIsComingPastMyWindow/0.1 (your-email@example.com)
